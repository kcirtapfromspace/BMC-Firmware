# interface file auto-generated by buildroot
# Link aggregation enabled for ge0/ge1

auto lo
iface lo inet loopback

# Bond interface for link aggregation (ge0 + ge1)
# Mode: balance-alb (adaptive load balancing) - no switch config required
# Alternative modes:
#   active-backup  - failover only, no load balancing
#   balance-rr     - round-robin (requires switch support)
#   802.3ad        - LACP (requires switch LACP support)
auto bond0
iface bond0 inet manual
  pre-up ip link add bond0 type bond mode balance-alb miimon 100 || true
  pre-up ip link set ge0 down || true
  pre-up ip link set ge1 down || true
  pre-up ip link set ge0 master bond0 || true
  pre-up ip link set ge1 master bond0 || true
  up ip link set bond0 up

# Bridge interface with bonded uplink
auto br0
iface br0 inet dhcp
  bridge-ports node1 node2 node3 node4 bond0
  pre-up /etc/network/nfs_check
  wait-delay 15
  hostname $(hostname)
