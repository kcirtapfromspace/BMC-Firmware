#!/bin/sh
#
# network-recovery - Interactive network recovery tool for TuringPi BMC
#
# This tool provides a simple menu-driven interface for recovering from
# network configuration problems. It is designed to be used via USB serial
# console when network access is unavailable.
#
# Usage: network-recovery
#
# All actions are logged to syslog with the network-recovery tag.
#

# Configuration paths
INTERFACES_FILE="/etc/network/interfaces"
INTERFACES_BACKUP="/etc/network/interfaces.backup"
BONDING_ENABLED="/etc/bonding.enabled"
BONDING_CONF="/etc/bonding.conf"

# Default interfaces configuration (factory reset content)
# shellcheck disable=SC2016  # $(hostname) intentionally literal - not expanded
DEFAULT_INTERFACES='# interface file auto-generated by buildroot
auto lo
iface lo inet loopback

auto br0
iface br0 inet dhcp
  bridge-ports node1 node2 node3 node4 ge0 ge1
  pre-up /etc/network/nfs_check
  wait-delay 15
  hostname $(hostname)

# Static fallback IP - always accessible for recovery
auto br0:1
iface br0:1 inet static
  address 192.168.0.2
  netmask 255.255.255.0
'

# Log to syslog and echo to user
log_info() {
    logger -t network-recovery -p user.info "$1"
    echo "$1"
}

log_warning() {
    logger -t network-recovery -p user.warning "$1"
    echo "Warning: $1"
}

log_error() {
    logger -t network-recovery -p user.err "$1"
    echo "Error: $1" >&2
}

# Display header
show_header() {
    clear
    echo "=============================================="
    echo "   TuringPi BMC Network Recovery Tool"
    echo "=============================================="
    echo ""
}

# Option 1: Show current network status
show_status() {
    show_header
    echo "=== Network Interface Status ==="
    echo ""
    ip addr show 2>/dev/null | grep -E "^[0-9]+:|inet |state "
    echo ""

    echo "=== Bridge Status ==="
    if command -v bridge >/dev/null 2>&1; then
        bridge link show 2>/dev/null || echo "No bridge information available"
    else
        # Fallback for systems without bridge command
        if [ -d /sys/class/net/br0/brif ]; then
            echo "br0 ports:"
            ls /sys/class/net/br0/brif/ 2>/dev/null || echo "  (none)"
        else
            echo "Bridge br0 not found"
        fi
    fi
    echo ""

    echo "=== Bonding Status ==="
    if [ -f /proc/net/bonding/bond0 ]; then
        cat /proc/net/bonding/bond0
    else
        echo "Bonding not active"
        if [ -f "$BONDING_ENABLED" ]; then
            echo "(Bonding is enabled but bond0 not created)"
        else
            echo "(Bonding is disabled)"
        fi
    fi
    echo ""

    echo "=== Bonding Configuration ==="
    if [ -f "$BONDING_ENABLED" ]; then
        echo "Bonding: ENABLED"
    else
        echo "Bonding: DISABLED"
    fi
    if [ -f "$BONDING_CONF" ]; then
        mode=$(head -1 "$BONDING_CONF" 2>/dev/null)
        echo "Mode: $mode"
    else
        echo "Mode: (not configured, default: active-backup)"
    fi
    echo ""

    echo "Press Enter to return to menu..."
    read -r _
}

# Option 2: Reset to factory defaults
reset_to_defaults() {
    show_header
    echo "=== Reset to Factory Defaults ==="
    echo ""
    echo "This will:"
    echo "  1. Restore /etc/network/interfaces to factory default"
    echo "  2. Remove /etc/bonding.enabled (disable bonding)"
    echo "  3. Restart networking"
    echo ""
    echo "WARNING: Current network configuration will be lost!"
    echo ""
    printf "Are you sure? (yes/no): "
    read -r confirm

    if [ "$confirm" != "yes" ]; then
        echo "Cancelled."
        echo ""
        echo "Press Enter to return to menu..."
        read -r _
        return
    fi

    log_info "Resetting network to factory defaults"

    # Backup current config if no backup exists
    if [ ! -f "$INTERFACES_BACKUP" ]; then
        cp "$INTERFACES_FILE" "$INTERFACES_BACKUP" 2>/dev/null
        log_info "Created backup at $INTERFACES_BACKUP"
    fi

    # Write factory default interfaces
    printf '%s' "$DEFAULT_INTERFACES" > "$INTERFACES_FILE"
    log_info "Restored factory default interfaces"

    # Remove bonding marker
    if [ -f "$BONDING_ENABLED" ]; then
        rm -f "$BONDING_ENABLED"
        log_info "Removed bonding marker file"
    fi

    # Restart networking
    echo ""
    echo "Restarting network..."
    /etc/init.d/S40network restart 2>&1

    log_info "Factory reset complete"
    echo ""
    echo "Press Enter to return to menu..."
    read -r _
}

# Option 3: Disable bonding
disable_bonding() {
    show_header
    echo "=== Disable Bonding ==="
    echo ""

    if [ ! -f "$BONDING_ENABLED" ]; then
        echo "Bonding is already disabled."
        echo ""
        echo "Press Enter to return to menu..."
        read -r _
        return
    fi

    echo "This will disable bonding and restart networking."
    echo "ge0 and ge1 will be added directly to br0."
    echo ""
    printf "Proceed? (yes/no): "
    read -r confirm

    if [ "$confirm" != "yes" ]; then
        echo "Cancelled."
        echo ""
        echo "Press Enter to return to menu..."
        read -r _
        return
    fi

    log_info "Disabling bonding"

    # Remove bonding marker
    rm -f "$BONDING_ENABLED"
    log_info "Removed $BONDING_ENABLED"

    # Restart networking (S45bonding will see marker is gone)
    echo ""
    echo "Restarting network..."

    # Stop bonding first
    /etc/init.d/S45bonding stop 2>&1

    # Restart main network
    /etc/init.d/S40network restart 2>&1

    log_info "Bonding disabled"
    echo ""
    echo "Press Enter to return to menu..."
    read -r _
}

# Option 4: Set static IP
set_static_ip() {
    show_header
    echo "=== Set Static IP Address ==="
    echo ""
    echo "Current br0 IP addresses:"
    ip addr show br0 2>/dev/null | grep "inet " | awk '{print "  " $2}'
    echo ""

    # Get IP address
    printf "Enter IP address (e.g., 192.168.1.100): "
    read -r ip_addr
    if [ -z "$ip_addr" ]; then
        echo "Cancelled."
        echo ""
        echo "Press Enter to return to menu..."
        read -r _
        return
    fi

    # Validate IP format (basic check)
    if ! echo "$ip_addr" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        log_error "Invalid IP address format: $ip_addr"
        echo ""
        echo "Press Enter to return to menu..."
        read -r _
        return
    fi

    # Get netmask
    printf "Enter netmask (default: 255.255.255.0): "
    read -r netmask
    if [ -z "$netmask" ]; then
        netmask="255.255.255.0"
    fi

    # Get gateway
    printf "Enter gateway (leave blank for none): "
    read -r gateway

    echo ""
    echo "Configuration:"
    echo "  IP Address: $ip_addr"
    echo "  Netmask:    $netmask"
    echo "  Gateway:    $gateway"
    echo ""
    printf "Apply this configuration? (yes/no): "
    read -r confirm

    if [ "$confirm" != "yes" ]; then
        echo "Cancelled."
        echo ""
        echo "Press Enter to return to menu..."
        read -r _
        return
    fi

    log_info "Setting static IP: $ip_addr/$netmask gateway=$gateway"

    # Backup current config
    if [ ! -f "$INTERFACES_BACKUP" ]; then
        cp "$INTERFACES_FILE" "$INTERFACES_BACKUP" 2>/dev/null
        log_info "Created backup at $INTERFACES_BACKUP"
    fi

    # Create new interfaces file with static IP
    cat > "$INTERFACES_FILE" << EOF
# interface file - static configuration
auto lo
iface lo inet loopback

auto br0
iface br0 inet static
  address $ip_addr
  netmask $netmask
EOF

    # Add gateway if specified
    if [ -n "$gateway" ]; then
        echo "  gateway $gateway" >> "$INTERFACES_FILE"
    fi

    # Add remaining bridge configuration
    cat >> "$INTERFACES_FILE" << 'EOF'
  bridge-ports node1 node2 node3 node4 ge0 ge1
  pre-up /etc/network/nfs_check
  wait-delay 15

# Static fallback IP - always accessible for recovery
auto br0:1
iface br0:1 inet static
  address 192.168.0.2
  netmask 255.255.255.0
EOF

    log_info "Updated $INTERFACES_FILE with static IP configuration"

    # Restart networking
    echo ""
    echo "Restarting network..."
    /etc/init.d/S40network restart 2>&1

    log_info "Static IP configured: $ip_addr"
    echo ""
    echo "Press Enter to return to menu..."
    read -r _
}

# Option 5: Test connectivity
test_connectivity() {
    show_header
    echo "=== Test Network Connectivity ==="
    echo ""

    # Get default gateway
    gateway=$(ip route 2>/dev/null | grep "^default" | awk '{print $3}' | head -1)

    echo "Testing gateway ($gateway)..."
    if [ -n "$gateway" ]; then
        if ping -c 1 -W 5 "$gateway" >/dev/null 2>&1; then
            echo "  Gateway: OK (reachable)"
        else
            echo "  Gateway: FAILED (unreachable)"
        fi
    else
        echo "  Gateway: NOT CONFIGURED"
    fi
    echo ""

    echo "Testing internet (8.8.8.8)..."
    if ping -c 1 -W 5 8.8.8.8 >/dev/null 2>&1; then
        echo "  Internet: OK (reachable)"
    else
        echo "  Internet: FAILED (unreachable)"
    fi
    echo ""

    log_info "Connectivity test completed"
    echo ""
    echo "Press Enter to return to menu..."
    read -r _
}

# Main menu
show_menu() {
    show_header
    echo "Select an option:"
    echo ""
    echo "  1) Show current network status"
    echo "  2) Reset to factory defaults"
    echo "  3) Disable bonding"
    echo "  4) Set static IP"
    echo "  5) Test connectivity"
    echo ""
    echo "  q) Quit"
    echo ""
    printf "Choice: "
}

# Main loop
main() {
    log_info "Network recovery tool started"

    while true; do
        show_menu
        read -r choice

        case "$choice" in
            1)
                show_status
                ;;
            2)
                reset_to_defaults
                ;;
            3)
                disable_bonding
                ;;
            4)
                set_static_ip
                ;;
            5)
                test_connectivity
                ;;
            q|Q)
                log_info "Network recovery tool exited"
                echo "Goodbye."
                exit 0
                ;;
            *)
                echo "Invalid choice. Press Enter to continue..."
                read -r _
                ;;
        esac
    done
}

# Run main function
main
